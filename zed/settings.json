{
  "proxy": "",
  "cursor_animation": {
    "enabled": true,
  },
  "show_whitespaces": "none",
  "relative_line_numbers": "enabled",
  "which_key": {
    "delay_ms": 0,
  },
  "autosave": "off",
  "icon_theme": "Colored Zed Icons Theme Dark",
  // "theme_overrides": {
  //   "Catppuccin Mocha": {
  //     "border.variant": "#1e1e2e",
  //     "border": "#1e1e2e",
  //     "title_bar.background": "#1e1e2e",
  //     "panel.background": "#1e1e2e",
  //     "tab.active_background": "#313244",
  //     "tab.inactive_background": "#1e1e2e",
  //   },
  // },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },
  "use_system_window_tabs": false,
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_project_panel": true,
    "enabled": true,
  },
  "accessible_mode": false,
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
    "show": true,
  },
  "file_finder": {
    "modal_max_width": "small",
  },
  "title_bar": {
    "show_branch_name": false,
    "show_project_items": false,
    "show_user_menu": true,
    "button_layout": "platform_default",
    "show_onboarding_banner": false,
    "show_worktree_name": false,
  },
  "status_bar": {
    "experimental.show": false,
    "active_language_button": true,
    "show_active_file": true,
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
  },

  "gutter": {
    "min_line_number_digits": 0,
  },
  "cli_default_open_behavior": "existing_window",
  "show_edit_predictions": false,
  // "autosave": "on_focus_change",
  "format_on_save": "on",
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "replace": "hollow",
      "visual": "hollow",
      "insert": "bar",
    },
    "highlight_on_yank_duration": 50,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "buffer_font_family": "CaskaydiaCove Nerd Font Propo",
  // "buffer_font_weight": 500,
  "terminal": {
    "cursor_shape": "bar",
    "font_size": 20.0,
    "dock": "bottom",
    "font_family": "CaskaydiaCove Nerd Font Mono",
    "working_directory": "current_project_directory",
    "copy_on_select": true,
  },
  "project_panel": {
    "default_width": 400.0,
    "auto_fold_dirs": false,
    "dock": "left",
    "hide_root": true,
    "sticky_scroll": false,
  },
  "outline_panel": {
    "button": false,
    "default_width": 400.0,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "google",
      "model": "gemini-3.8-flash",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ui_font_size": 17.0,
  "ui_font_family": "Geist",
  "buffer_font_size": 20,
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Tokyo Night Storm",
  },

  "cursor_shape": "block",
  "cursor_blink": false,

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },

  "indent_guides": {
    "coloring": "indent_aware",
  },

  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "warning",
    },
  },

  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/target",
    "**/.next",
    "**/dist",
    "**/build",
  ],

  "close_on_file_delete": true,
  "confirm_quit": false,

  "multi_cursor_modifier": "alt",

  "scrollbar": {
    "show": "never",
  },
  "seed_search_query_from_cursor": "never",
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
}
